# CodeEval AI - Environment Configuration
APP_NAME="CodeEval AI"
APP_ENV=development
API_V1_STR=/api
SECRET_KEY=codeeval-super-secret-jwt-key-change-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database: SQLite for instant local dev or PostgreSQL for production
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/codeeval_db
DATABASE_URL=sqlite:///./codeeval.db

# Redis / Caching (optional)
REDIS_URL=redis://localhost:6379/0

# Code Execution Engine
# Use native local isolated sandbox runner by default, or connect to Judge0
USE_JUDGE0=false
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
